# .env for docker compose on srv01chambly. Copy to .env and fill in.
# These two identify your Cloudflare Access application; they are not secrets.
WORKBENCH_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
WORKBENCH_ACCESS_AUDIENCE=paste-the-application-aud-tag-here
# Optional: host port on 127.0.0.1 that cloudflared points to (default 8080).
# WORKBENCH_PUBLISH_PORT=8080
