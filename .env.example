# .env for docker compose on srv01chambly. Copy to .env, then paste the tunnel token.
# Cloudflare Access application "Now Workbench" (identifiers, not secrets).
WORKBENCH_ACCESS_TEAM_DOMAIN=dark-morning-3aea.cloudflareaccess.com
WORKBENCH_ACCESS_AUDIENCE=04d127586495c74f23669c37254026846e81e09cacf2bcc963ef1d0d528e81f0
# SECRET: token of the "workbench" tunnel (Cloudflare > Networking > Tunnels > workbench).
# Paste it on the server only; never commit it.
CLOUDFLARE_TUNNEL_TOKEN=
# SECRET (optional): the shared Claude API key. When set it replaces the key entered in
# Settings; change it here and run `docker compose up -d`. Paste on the server only.
WORKBENCH_ANTHROPIC_API_KEY=
