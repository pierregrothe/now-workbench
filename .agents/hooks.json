{
  "now-workbench-governance": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYENV_VERSION .venv/bin/python .agents/scripts/pre_tool_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "env -u PYENV_VERSION .venv/bin/python scripts/dev-tools/per_edit_check.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "env -u PYENV_VERSION .venv/bin/python .ratchet/ratchet_check.py all && env -u PYENV_VERSION .venv/bin/python .claude/scripts/primer-reconcile.py || true"
      }
    ]
  }
}
