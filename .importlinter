# .importlinter
# Architecture contracts of ADR-015, checked by `lint-imports` at every commit.

[importlinter]
root_package = now_workbench

[importlinter:contract:layers]
name = Layers: interfaces > domains > platform (never upward)
type = layers
layers =
    now_workbench.interfaces
    now_workbench.domains
    now_workbench.platform

[importlinter:contract:acyclic-domains]
name = Domains depend on each other without cycles
type = acyclic_siblings
ancestors =
    now_workbench.domains

[importlinter:contract:root-bundles]
name = Public root: other packages import domains.bundles only through its __init__
type = protected
protected_modules =
    now_workbench.domains.bundles.*
allowed_importers =
    now_workbench.domains.bundles

[importlinter:contract:root-capture]
name = Public root: other packages import domains.capture only through its __init__
type = protected
protected_modules =
    now_workbench.domains.capture.*
allowed_importers =
    now_workbench.domains.capture

[importlinter:contract:root-conversations]
name = Public root: other packages import domains.conversations only through its __init__
type = protected
protected_modules =
